# Katalog domowy Claude Code (domyślnie ~/.claude)
# CLAUDE_CONFIG_DIR=/home/uzytkownik/.claude

# Gdzie panel trzyma własną konfigurację: repozytoria, serwery MCP, przestrzenie robocze
# (domyślnie ~/.claude-session-manager/config.json)
# CSM_DATA_DIR=/home/uzytkownik/.claude-session-manager

# Katalogi, w których wolno startować nowe sesje (rozdzielone dwukropkiem).
# Puste = dowolny katalog. Ustaw to, jeśli panel ma być dostępny poza localhostem.
# CSM_ALLOWED_ROOTS=/home/uzytkownik/projekty:/home/uzytkownik/praca

# Prosty token dostępu. Gdy ustawiony, panel wymaga podania go przy wejściu.
# CSM_ACCESS_TOKEN=jakis-dlugi-losowy-ciag

# Domyślny model dla nowych sesji (alias lub pełna nazwa)
# CSM_DEFAULT_MODEL=claude-sonnet-4-5

# Domyślny tryb uprawnień: default | acceptEdits | plan | dontAsk | bypassPermissions
CSM_DEFAULT_PERMISSION_MODE=default
