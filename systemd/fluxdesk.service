# Szablon. Instalator generuje wersję z prawdziwymi ścieżkami;
# %h oznacza katalog domowy użytkownika.
[Unit]
Description=Fluxdesk, pulpit sterowania sesjami Claude Code
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/claude-session-manager
# Wersja produkcyjna. Tryb deweloperski kompiluje strony przy każdym żądaniu,
# co przy pisaniu w terminalu daje odczuwalne opóźnienie: 12 do 111 ms na znak
# zamiast 2 ms. Osobny katalog build sprawia, że przebudowa w innej sesji nie
# wywraca działającego panelu.
ExecStart=/usr/bin/npm run start
# Gospodarze terminali są procesami potomnymi panelu. Bez tego systemd zabija
# przy restarcie całą grupę i wszystkie sesje giną razem z nim.
KillMode=process
Restart=on-failure
RestartSec=3
# Pod systemd brakuje ~/.local/bin, a tam mieszka claude.
Environment=NEXT_DIST_DIR=.next-service
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin

[Install]
WantedBy=default.target
